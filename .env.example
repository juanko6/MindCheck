# Copia este archivo a .env y rellena los valores. Nunca subas el .env al repositorio.

# ---------- OpenAI ----------
OPENAI_API_KEY=
MODELO_GPT=gpt-4o-mini
TEMPERATURE=0.4
# Máximo de caracteres de texto que se envían a la IA
MAX_CARACTERES=1500000

# ---------- Base de datos ----------
POSTGRES_USER=mindcheck
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=mindcheck
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Backend ----------
# Genera uno propio: openssl rand -hex 32
SECRET_KEY=cambia-este-secreto
ACCESS_TOKEN_EXPIRE_MINUTES=120
BACKEND_PORT=8000
API_BASE_PATH=/api/v1
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:3000
# Dominios de email permitidos para registrarse, separados por comas
ALLOWED_EMAIL_DOMAINS=
# development | production
ENVIRONMENT=development

# ---------- Email (códigos de verificación) ----------
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ---------- Frontend ----------
# URL pública del backend; NEXT_PUBLIC_API_URL se construye como PUBLIC_HOST + API_BASE_PATH
PUBLIC_HOST=http://localhost:8000
NEXT_PUBLIC_STATIC_URL=http://localhost:8000
NEXT_PUBLIC_PALABRAS_POR_BLOQUE=400
NEXT_PUBLIC_TOKENS_POR_BLOQUE=10
